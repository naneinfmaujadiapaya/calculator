<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:hasCode="false">

        <!-- No Java/Kotlin code: android.app.NativeActivity hands control
             straight to native_app_glue, which raylib uses to drive the
             same main() as the desktop build. android.app.lib_name must
             match the target name in app/CMakeLists.txt (no "lib" prefix,
             no ".so" suffix). -->
        <activity
            android:name="android.app.NativeActivity"
            android:label="@string/app_name"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="calculator" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
